<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许用户安装的 CA 证书（用于调试代理抓包） -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- 123pan WebDAV 服务器的 SSL 配置 -->
    <domain-config>
        <domain includeSubdomains="true">webdav.123pan.cn</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
